{
  "name": "my_portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Rayyan Ahmed Khan's portfolio site",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,mjs,jsx,ts,mts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,mjs,jsx,ts,mts,tsx,json,css,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "esbuild": "^0.25.10",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.10",
    "terser": "^5.37.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.3",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.10",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "allowScripts": {
    "@swc/core@1.16.0": true,
    "esbuild@0.25.10": true
  }
}
